# Copy to .env. Never commit credentials or actual employee information.
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:4b-instruct
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=1024
OLLAMA_NUM_THREAD=6
OLLAMA_THINK=auto
MODEL_TIMEOUT_SECONDS=180
# Hosted alternative: set LLM_PROVIDER=openai, LLM_MODEL, and these values.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
DATABASE_PATH=data/support.db
CHECKPOINT_PATH=data/checkpoints.db
MAX_MODEL_STEPS=6
MAX_TOOL_CALLS=8
MAX_HISTORY_MESSAGES=100
APPROVAL_TTL_SECONDS=1800
LOG_LEVEL=INFO
# Streamlit talks to this backend URL, from the Streamlit server.
API_BASE_URL=http://localhost:8000

# Optional public deployment mode. Local Ollama works with the defaults above.
APP_MODE=local
STORAGE_MODE=local
# Only cloud + ephemeral: create a fresh pair of synthetic databases each boot.
RESET_DEMO_ON_START=false
# Cloud mode requires a random shared key >=32 characters, stored on both servers.
# This is separate from the LLM provider key; never deliver either key to browsers.
SUPPORT_API_KEY=
# Empty for Streamlit server-to-server calls. No wildcard origins are accepted.
CORS_ALLOWED_ORIGINS=
MAX_COMPLETION_TOKENS=2048
# Optional, only for hosted models that accept this parameter: low/medium/high.
HOSTED_REASONING_EFFORT=
MAX_CONTEXT_CHARACTERS=24000
MAX_MODEL_CALLS_PER_DAY=200
MAX_CONVERSATIONS_PER_SESSION=5
MAX_CONVERSATIONS_TOTAL=200
DEMO_REQUESTS_PER_MINUTE=180
DEMO_ACTIONS_PER_MINUTE=6
MAX_REQUEST_BODY_BYTES=20000
# Backend launcher uses PORT, default 8000; Render supplies its own value.
