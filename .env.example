# Copy to .env. Never commit credentials or actual employee information.
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:4b-instruct
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=1024
OLLAMA_NUM_THREAD=6
OLLAMA_THINK=auto
MODEL_TIMEOUT_SECONDS=180
# Hosted alternative: set LLM_PROVIDER=openai, LLM_MODEL, and these values.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
DATABASE_PATH=data/support.db
CHECKPOINT_PATH=data/checkpoints.db
MAX_MODEL_STEPS=6
MAX_TOOL_CALLS=8
MAX_HISTORY_MESSAGES=100
APPROVAL_TTL_SECONDS=1800
LOG_LEVEL=INFO
# Streamlit talks to this backend URL, from the Streamlit server.
API_BASE_URL=http://localhost:8000
